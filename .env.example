# Supabase (authentication)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe billing (web — Checkout redirect; secrets live in Supabase Edge Functions)
# Optional client-side publishable key if Stripe.js is added later
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Test price IDs (see docs/stripe-billing.md)
# STRIPE_PRICE_ID_MONTHLY=price_1TrOOs2Ls7JojLJZijEv3TUK
# STRIPE_PRICE_ID_YEARLY=price_1TrOOr2Ls7JojLJZok7d6j7l

# Optional monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
