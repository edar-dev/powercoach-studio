# Environment (copy from powercoach-studio-flutter or .env.example)
.env
.env.local
.env.*.local

# Stitch URLs (copy from design/stitch-urls.example.json, do not commit real URLs)
design/stitch-urls.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Drift web assets (downloaded in scripts/vercel-build.sh)
web/sqlite3.wasm
web/drift_worker.js

# Flutter/Dart/Pub related
.flutter_sdk/
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.vercel
